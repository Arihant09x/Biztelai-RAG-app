# ==============================================================================
# BiztelAI Manufacturing SOP AI Copilot - Environment Configuration Template
# ==============================================================================

# Application Environment (development, testing, production)
APP_ENV=development
SECRET_KEY=replace-with-a-secure-random-secret-key-at-least-32-chars
JWT_SECRET_KEY=replace-with-a-secure-random-jwt-key-at-least-32-chars
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOG_LEVEL=INFO
SENTRY_DSN=

# ==============================================================================
# Multi-Provider LLM Integration (OpenAI-compatible)
# ==============================================================================
# Examples:
# OpenAI:     LLM_API_BASE_URL=https://api.openai.com/v1, LLM_MODEL=gpt-4o-mini
# Gemini:     LLM_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai, LLM_MODEL=gemini-1.5-flash
# OpenRouter: LLM_API_BASE_URL=https://openrouter.ai/api/v1, LLM_MODEL=anthropic/claude-3.5-sonnet
LLM_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=your-llm-api-key-here
LLM_MODEL=gemini-1.5-flash
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_SECONDS=45

# ==============================================================================
# Database Configuration (PostgreSQL with pgvector)
# ==============================================================================
# For local Docker: postgresql://postgres:postgres@localhost:5432/biztelai_sop
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/biztelai_sop
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# ==============================================================================
# Redis / Celery Background Processing
# ==============================================================================
# Upstash Redis Provider configuration format:
# rediss://default:<password>@<endpoint>.upstash.io:6379
# (The double 's' in rediss:// enables TLS encryption required by Upstash)
REDIS_URL=rediss://default:YOUR_UPSTASH_PASSWORD@YOUR_UPSTASH_ENDPOINT.upstash.io:6379
CELERY_BROKER_URL=rediss://default:YOUR_UPSTASH_PASSWORD@YOUR_UPSTASH_ENDPOINT.upstash.io:6379
CELERY_RESULT_BACKEND=rediss://default:YOUR_UPSTASH_PASSWORD@YOUR_UPSTASH_ENDPOINT.upstash.io:6379

# ==============================================================================
# JWT Authentication Settings
# ==============================================================================
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRES_DAYS=14

# ==============================================================================
# Embedding & Reranking Settings
# ==============================================================================
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=32

RERANKER_ENABLED=true
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RETRIEVAL_TOP_K=10
RERANK_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.35

# ==============================================================================
# Document Processing & Chunking
# ==============================================================================
CHUNK_SIZE=700
CHUNK_OVERLAP=100
STORAGE_BACKEND=local
DOCUMENT_STORAGE_PATH=./data/documents
MAX_UPLOAD_SIZE_MB=50
OCR_ENABLED=true

